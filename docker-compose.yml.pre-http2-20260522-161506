  # Nginx Gateway eliminado: Rust maneja todo ahora

  bot:
    build:
      context: ./bot
      dockerfile: Dockerfile
    restart: unless-stopped
    env_file: [ .env ]
    environment:
      - API_URL_BASE=http://backend:3006/api/discord
    depends_on:
      - backend
    networks:
      - ragenodes_net

  tunnel:
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    command: tunnel --no-autoupdate run --token ${CF_TUNNEL_TOKEN}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - ragenodes_net

networks:
  ragenodes_net:
    name: ragenodes_net

volumes:
  postgres_data:
  mariadb_data:
