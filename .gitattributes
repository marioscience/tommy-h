# Monaco is a vendored, generated bundle. Preserve it byte-for-byte and do not
# report upstream whitespace conventions as project-source errors.
frontend/public/vendor/monaco/** -whitespace

# Los artefactos ejecutados en servidores Linux deben conservar LF aunque se
# editen desde Windows.
*.sh text eol=lf
.env.example text eol=lf
.env.local.example text eol=lf
