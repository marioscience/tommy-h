NODE_ENV=development
PORT=3006
PROJECT_ROOT=/opt/ragenodes-ultimate
PUBLIC_BASE_URL=http://localhost:8088
CORS_ORIGIN=http://localhost:8088,http://127.0.0.1:8088
TRUSTED_BASE_DOMAINS=ragenodes.com,ragenodes.app,ragenodes.dev
SESSION_COOKIE_NAME=rn_session
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

JWT_SECRET=local-only-development-jwt-secret-not-for-production
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=local-only-development-admin-password
DISCORD_API_KEY=local-only-development-discord-api-key
NODE_ENROLLMENT_API_KEY=local-only-development-node-enrollment-key
CENTRAL_DB_PASS=local-only-mariadb-root-password

HOST_BIND_FRONTEND_PORT=8088
PROXY_BIND_IP=127.0.0.1
FRONTEND_BIND_IP=127.0.0.1
HOST_BIND_BACKEND_PORT=3010
PHPMYADMIN_PORT=8089
STAGING_MODE=false
STAGING_UPSTREAM=
STAGING_TLS_UPSTREAM=
STAGING_TLS_DOMAINS=ragenodes.dev
ACCESS_GATE_ENABLED=false
ACCESS_GATE_DOMAIN=ragenodes.dev
ACCESS_GATE_ALLOWED_EMAIL_DOMAIN=ragenodes.com

POSTGRES_DB=ragenodes
POSTGRES_USER=ragenodes
POSTGRES_PASSWORD=local-only-postgres-password
DATABASE_URL=postgres://ragenodes:local-only-postgres-password@postgres:5432/ragenodes
PG_POOL_MAX=10
PG_SLOW_QUERY_MS=250

PAYPAL_CLIENT=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOKS_ENABLED=false
RESEND_API_KEY=

DISCORD_TOKEN=
DISCORD_STAFF_WEBHOOK=
DISCORD_MODERATION_CHANNEL_ID=
API_URL_BASE=http://backend:3006/api/discord

DOCKER_SOCKET=/var/run/docker.sock
DOCKER_BLKIO_WEIGHT=0
ALLOW_ROOTFUL_DOCKER_SOCKET=true
ALLOW_INSECURE_DOCKER_NODES=false
APP_UID=1000
APP_GID=1000
# En Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=1001
INSTANCE_DATA_ROOT=${HOME}/.local/share/ragenodes-ultimate/data
BACKUP_ROOT=${HOME}/.local/share/ragenodes-ultimate/backups
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_NAME=gdrive
BACKUP_REMOTE_PATH=ragenodes_backups
RCLONE_CONFIG_PATH=/app/config/rclone/rclone.conf
RCLONE_CONFIG_HOST_PATH=./config/rclone/rclone.conf
ALLOW_RPC_PORTMAPPER=false

FIVEM_BASE_IMAGE=ragenodes-fivem-base:1.0.0-local
BLENDER_BASE_IMAGE=ragenodes-blender-web:1.0.0-local
FIVEM_PUBLIC_HOST=localhost
FIVEM_PUBLIC_IP=127.0.0.1
PUBLIC_ENDPOINT_HOST=localhost
PUBLIC_ENDPOINT_SCHEME=http
FIVEM_PORT_START=30120
TXADMIN_PORT_START=40120
BLENDER_PORT_START=50120
SERVER_LIMIT_PER_USER=50
ALLOW_LOCAL_ADMIN=true

BACKUP_CONCURRENCY=1
CONTAINER_STATE_CACHE_MS=4000
DOCKER_QUERY_CHUNK_SIZE=5
MAINTENANCE_CHUNK_SIZE=3
MAINTENANCE_INTERVAL_MS=60000
REMOTE_DOWNLOAD_MAX_BYTES=10737418240
RAGENODES_ROLE=backend-api
