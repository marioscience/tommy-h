NODE_ENV=production
PORT=3006
PUBLIC_BASE_URL=https://ragenodes.com
CORS_ORIGIN=https://ragenodes.com
TRUSTED_BASE_DOMAINS=ragenodes.com,ragenodes.app,ragenodes.dev
SESSION_COOKIE_NAME=rn_session
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict
JWT_SECRET=change_me_generate_a_long_random_secret
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=change_me_immediately
DISCORD_API_KEY=change_me_generate_a_discord_service_api_key
NODE_ENROLLMENT_API_KEY=change_me_generate_a_distinct_node_enrollment_key
GRAFANA_ADMIN_PASSWORD=change_me_generate_a_grafana_password

HOST_BIND_FRONTEND_PORT=8088
PROXY_BIND_IP=127.0.0.1
# El puerto HTTP auxiliar nunca debe heredar la IP publica del proxy TLS.
FRONTEND_BIND_IP=127.0.0.1
BACKEND_REPLICAS=
BACKEND_REPLICA_MAX=4
BACKEND_CPU_BUDGET_PERCENT=20
BACKEND_MEMORY_MB_PER_REPLICA=512
BACKEND_MEMORY_RESERVE_MB=2048
BACKEND_PG_POOL_MAX=10
BACKEND_AUTOSCALE_ENABLED=false
BACKEND_AUTOSCALE_MIN=2
BACKEND_AUTOSCALE_MAX=4
BACKEND_AUTOSCALE_UP_CPU_PERCENT=65
BACKEND_AUTOSCALE_UP_P95_MS=300
BACKEND_AUTOSCALE_UP_EVENT_LOOP_MS=100
BACKEND_AUTOSCALE_UP_ERROR_RATE=0.02
BACKEND_AUTOSCALE_DOWN_CPU_PERCENT=25
BACKEND_AUTOSCALE_DOWN_P95_MS=100
BACKEND_AUTOSCALE_DOWN_RPS_PER_REPLICA=15
BACKEND_AUTOSCALE_UP_SAMPLES=2
BACKEND_AUTOSCALE_DOWN_SAMPLES=10
BACKEND_AUTOSCALE_UP_COOLDOWN_SECONDS=180
BACKEND_AUTOSCALE_DOWN_COOLDOWN_SECONDS=600
OXIDE_API_DNS_TTL_SECONDS=5
OXIDE_API_FAILURE_COOLDOWN_SECONDS=5
PHPMYADMIN_PORT=8089
STAGING_MODE=false
# Optional domain and host:port used when this proxy is the public staging edge.
STAGING_UPSTREAM=
STAGING_TLS_UPSTREAM=
STAGING_TLS_DOMAINS=ragenodes.dev
STAGING_DOMAIN=staging.ragenodes.com

# OxideProxy: TLS directo con Let's Encrypt. Mantener ambos interruptores en
# false durante desarrollo local. Probar primero contra el directorio staging.
OXIDE_ACME_ENABLED=false
OXIDE_ACME_DOMAINS=ragenodes.dev
OXIDE_ACME_EMAIL=
OXIDE_ACME_PRODUCTION=false

# Puerta de acceso de preproducción. Solo admite el dominio corporativo exacto;
# el secreto debe ser aleatorio, exclusivo del entorno y tener 32+ caracteres.
ACCESS_GATE_ENABLED=true
ACCESS_GATE_DOMAIN=ragenodes.dev
ACCESS_GATE_SHARED_EDGE=true
ACCESS_GATE_ALLOWED_EMAIL_DOMAIN=ragenodes.com
ACCESS_GATE_SESSION_SECRET=
ACCESS_GATE_REDIS_URL=redis://redis:6379/0
ACCESS_GATE_FROM_EMAIL="RageNodes Access <info@ragenodes.com>"

POSTGRES_DB=ragenodes
POSTGRES_USER=ragenodes
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgres://ragenodes:change_me_postgres_password@postgres:5432/ragenodes
PG_POOL_MAX=25
PG_SLOW_QUERY_MS=250

CENTRAL_DB_PASS=change_me_mariadb_root_password

PAYPAL_CLIENT=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOKS_ENABLED=false
RESEND_API_KEY=

DOCKER_SOCKET=/run/user/1000/docker.sock
DOCKER_BLKIO_WEIGHT=100
ALLOW_ROOTFUL_DOCKER_SOCKET=false
ALLOW_INSECURE_DOCKER_NODES=false
# Activación progresiva: primero staging. Los juegos se publican a través del
# proceso Oxide Game y sus backends quedan ligados únicamente a loopback.
OXIDE_GAME_PROXY_ENABLED=false
GAME_BACKEND_PORT_OFFSET=10000
GAME_BACKEND_BIND_IP=127.0.0.1
OXIDE_GAME_PROXY_SERVICE=oxide_game
# APP_UID/APP_GID identifican el proceso de la API. DOCKER_GID permite usar el
# socket y GAME_DATA_GID permite leer/escribir datos creados por juegos rootless.
APP_UID=1000
APP_GID=1000
DOCKER_GID=999
# Si control y juegos usan el mismo daemon rootless, usa el GID interno del
# juego (normalmente 1000). Si el control es rootful y los juegos rootless,
# usa el GID remapeado visible en el host (por ejemplo 100999).
GAME_DATA_GID=1000
# Cuando el plano de control de staging es rootful y sus juegos son rootless,
# configura aqui el GID remapeado que el host muestra en los directorios de
# juego (por ejemplo: stat -c '%g' /srv/ragenodes-staging-data/<server-id>).
# Se mantiene separado para no alterar los permisos de produccion.
STAGING_GAME_DATA_GID=100999
# En staging con Docker rootless, GID 0 dentro del contenedor se mapea al
# grupo del usuario host (APP_GID). En Docker rootful conserva el valor 1000.
STAGING_GAME_CONTAINER_SHARED_GID=0
INSTANCE_DATA_ROOT=/srv/ragenodes-data
# Capacidad reservable: (RAM fisica - reserva del host) x ratio. El arranque
# sigue bloqueandose si la memoria fisica disponible invadiria la reserva.
NODE_RAM_OVERCOMMIT_RATIO=1.5
NODE_HOST_RAM_RESERVE_GB=8
BACKUP_ROOT=/srv/ragenodes-backups
BACKUP_ARCHIVE_ENGINE=tar
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_NAME=gdrive
BACKUP_REMOTE_PATH=ragenodes_backups
RCLONE_CONFIG_PATH=/app/config/rclone/rclone.conf
RCLONE_CONFIG_HOST_PATH=./config/rclone/rclone.conf
ALLOW_RPC_PORTMAPPER=false
FIVEM_BASE_IMAGE=ragenodes-fivem-base:1.0.0-local
BLENDER_BASE_IMAGE=ragenodes-blender-web:1.0.0-local
IMAGE_CACHE_ROOT=/opt/ragenodes-ultimate/.image-cache
IMAGE_ARCHIVE_ENABLED=true
FIVEM_VERSION_API=https://changelogs-live.fivem.net/api/changelog/versions/linux/server
FIVEM_PUBLIC_HOST=node1.ragenodes.com
PUBLIC_ENDPOINT_HOST=ragenodes.app
PUBLIC_ENDPOINT_SCHEME=https
PUBLIC_ENDPOINT_MODE=subdomain
PUBLIC_ENDPOINT_PREFIX=tx
# Dominios HTTPS deterministas servidos por OxideProxy sin túneles individuales.
OXIDE_DYNAMIC_WEB_DOMAINS=ragenodes.app,ragenodes.dev,ragenodes.com,node1.ragenodes.com
OXIDE_DYNAMIC_BACKEND_HOST=host.docker.internal
STAGING_DYNAMIC_DOMAIN=ragenodes.dev
OXIDE_DYNAMIC_STAGING_BACKEND_HOST=
OXIDE_TXADMIN_PORT_START=40100
OXIDE_TXADMIN_PORT_END=59999
OXIDE_BLENDER_PORT_START=50100
OXIDE_BLENDER_PORT_END=59999
OXIDE_FRAME_ANCESTORS="https://ragenodes.com https://www.ragenodes.com https://panel.ragenodes.app https://ragenodes.dev https://panel.ragenodes.dev https://staging.ragenodes.com"
STAGING_DOMAINS=ragenodes.dev,panel.ragenodes.dev
STAGING_PUBLIC_ENDPOINT_HOST=ragenodes.dev
STAGING_GAME_PUBLIC_HOST=node1.ragenodes.dev
# Mantiene los puertos de staging fuera de las bandas equivalentes de produccion.
STAGING_PORT_BASE_OFFSET=1000
# Cada entorno puede buscar como maximo dentro de su bloque de 1000 puertos (inicio + 0..999).
PRODUCTION_PORT_SCAN_LIMIT=999
STAGING_PORT_SCAN_LIMIT=999

# Perfil opcional PowerDNS + DNS-01. No se activa hasta delegar la zona DNS.
PDNS_API_KEY=change_me_generate_a_long_random_powerdns_api_key
POWERDNS_ZONE=ragenodes.dev
POWERDNS_EDGE_IPV4=
POWERDNS_BIND_IP=127.0.0.1
POWERDNS_DNS_PORT=5353
POWERDNS_API_PORT=8081
LEGO_EMAIL=
LEGO_ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
LEGO_ACTION=run
FIVEM_PORT_START=30120
TXADMIN_PORT_START=40120
BLENDER_PORT_START=50120
# Reintentos ante puertos ocupados por otro daemon o proceso del host.
PORT_BIND_RETRY_LIMIT=8
SERVER_LIMIT_PER_USER=1
ALLOW_LOCAL_ADMIN=false
BACKUP_CONCURRENCY=1
CONTAINER_STATE_CACHE_MS=4000
DOCKER_QUERY_CHUNK_SIZE=5
MAINTENANCE_CHUNK_SIZE=3
MAINTENANCE_INTERVAL_MS=60000
# Una plantilla de datos sin validacion reciente se omite para evitar que un
# reinicio reinstale binarios antiguos. El juego actualiza su volumen persistente.
TEMPLATE_MAX_AGE_DAYS=14
REMOTE_DOWNLOAD_MAX_BYTES=10737418240
RAGENODES_ROLE=backend-api
DEPLOYMENT_POLL_INTERVAL_MS=1500
DEPLOYMENT_MAX_IDLE_POLL_MS=30000
DEPLOYMENT_STALE_MINUTES=45
DEPLOYMENT_RETRY_BASE_SECONDS=15
DEPLOYMENT_PAYLOAD_KEY=change_me_generate_a_random_32_character_secret
STATS_HISTORY_INTERVAL_MS=300000
QUERY_WARMER_SERVER_REFRESH_MS=60000
QUERY_WARMER_MIN_CYCLE_MS=5000
QUERY_WARMER_MAX_CYCLE_MS=30000
# Background disk-usage telemetry. Customer reads never walk instance trees.
DISK_USAGE_COLLECTION_INTERVAL_MS=300000
DISK_USAGE_COLLECTION_CONCURRENCY=2
DISK_USAGE_LOCAL_CACHE_MS=60000
