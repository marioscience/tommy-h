NODE_ENV=production
PORT=3006
PUBLIC_BASE_URL=https://ragenodes.com
CORS_ORIGIN=https://ragenodes.com
SESSION_COOKIE_NAME=rn_session
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict
JWT_SECRET=change_me_generate_a_long_random_secret
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=change_me_immediately
API_KEY=change_me_generate_a_service_api_key
GRAFANA_ADMIN_PASSWORD=change_me_generate_a_grafana_password

HOST_BIND_FRONTEND_PORT=8088
PROXY_BIND_IP=127.0.0.1
HOST_BIND_BACKEND_PORT=3010
PHPMYADMIN_PORT=8089

POSTGRES_DB=ragenodes
POSTGRES_USER=ragenodes
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgres://ragenodes:change_me_postgres_password@postgres:5432/ragenodes

CENTRAL_DB_PASS=change_me_mariadb_root_password

PAYPAL_CLIENT=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOKS_ENABLED=false

DOCKER_SOCKET=/run/user/1000/docker.sock
DOCKER_BLKIO_WEIGHT=100
ALLOW_ROOTFUL_DOCKER_SOCKET=false
ALLOW_INSECURE_DOCKER_NODES=false
INSTANCE_DATA_ROOT=/srv/ragenodes-data
FIVEM_BASE_IMAGE=ragenodes-fivem-base:1.0.0-local
BLENDER_BASE_IMAGE=ragenodes-blender-web:1.0.0-local
FIVEM_PUBLIC_HOST=node1.ragenodes.com
FIVEM_PORT_START=30120
TXADMIN_PORT_START=40120
BLENDER_PORT_START=50120
SERVER_LIMIT_PER_USER=1
ALLOW_LOCAL_ADMIN=false
BACKUP_CONCURRENCY=1
CONTAINER_STATE_CACHE_MS=4000
DOCKER_QUERY_CHUNK_SIZE=5
MAINTENANCE_CHUNK_SIZE=3
MAINTENANCE_INTERVAL_MS=60000
REMOTE_DOWNLOAD_MAX_BYTES=10737418240
RAGENODES_ROLE=backend-api
